generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Models

model Organization {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("KOMISARIAT") // KOMISARIAT, CABANG
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  letters     Letter[]
  transactions Transaction[]
  posts       Post[]
  activities  Activity[]
}

model User {
  id                 String    @id @default(cuid())
  name               String
  username           String?   @unique
  email              String?   // Removed @unique
  password           String
  mustChangePassword Boolean   @default(true)
  role               String    @default("KADER") // PUBLIC, KADER, PENGURUS_KOMISARIAT, PENGURUS_CABANG, ADMIN_CABANG, SUPER_ADMIN
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])

  kaderProfile       KaderProfile?
}

model KaderProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rayon       String?
  komisariat  String?
  mapabaYear  String?
  pkdYear     String?
  pkdLocation String?
  pkdOrganizer String?
  pklYear     String?
  pklLocation String?
  pklOrganizer String?
  pknYear     String?
  pknLocation String?
  pknOrganizer String?
  otherTraining String? // Stores JSON stringified array of other trainings
  
  // New Fields
  campus         String?
  campusAddress  String?
  faculty        String?
  major          String? // Prodi / Jurusan
  address        String?
  noInduk     String?  @unique
  birthPlace  String?
  birthDate   DateTime?
  phone       String?
  
  // Verification Queue
  status      String    @default("PENDING") // PENDING, VERIFIED
}

model Post {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  content   String
  image     String?
  published Boolean   @default(false)
  author    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tags      PostTag[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  group String    @default("Umum") // Wilayah, Isu, Kaderisasi, Umum
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String?
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())
}

model Material {
  id            String   @id @default(cuid())
  title         String
  description   String?
  featuredImage String?
  isPublished   Boolean  @default(true)
  visibility    String   @default("PUBLIC") // PUBLIC, PRIVATE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  chapters      MaterialChapter[]
}

model MaterialChapter {
  id          String   @id @default(cuid())
  title       String?  // Bab Title
  description String?
  type        String   @default("DOCUMENT") // DOCUMENT, YOUTUBE
  fileUrl     String?
  youtubeUrl  String?
  sortOrder   Int      @default(0)
  
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Letter {
  id          String   @id @default(cuid())
  number      String
  type        String   @default("MASUK") // MASUK, KELUAR
  date        DateTime @default(now())
  sender      String?
  receiver    String?
  subject     String?
  fileUrl     String?
  createdAt   DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  type        String   @default("DEBIT") // DEBIT (Masuk), CREDIT (Keluar)
  amount      Float
  balance     Float    @default(0)
  createdAt   DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Activity {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String?
  organizer   String?
  scope       String   @default("PUBLIC") // CABANG, KOMISARIAT, PUBLIC
  published   Boolean  @default(false)
  image       String?  // Main Banner (Hero)
  
  // Invitation Fields
  isInvitation Boolean  @default(false)
  theme        String   @default("modern-blue")
  musicUrl     String?
  locationUrl  String?
  locationName String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  photos      ActivityImage[]
  rsvps       RSVP[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  pendaftar      Pendaftar[]
}

model RSVP {
  id          String   @id @default(cuid())
  name        String
  attendance  String   @default("HADIR") // HADIR, TIDAK_HADIR
  message     String?
  createdAt   DateTime @default(now())
  
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Pendaftar {
  id             String   @id @default(uuid())
  namaLengkap    String
  email          String
  noWhatsapp     String
  asalKomisariat String
  kehadiran      Boolean  @default(false)
  createdAt      DateTime @default(now())

  activityId     String
  activity       Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ActivityImage {
  id          String   @id @default(cuid())
  url         String
  createdAt   DateTime @default(now())
  
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}
